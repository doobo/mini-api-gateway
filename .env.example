PORT=5630

DATABASE_PATH=./data/gateway.db

# Static admin token (scripted access + password reset). Login sessions via
# POST /admin/auth/login work even without this.
ADMIN_TOKEN=change-me

# Default admin account seeded on first start (change after login!).
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123

# Login session lifetime in hours.
ADMIN_SESSION_TTL_HOURS=24

# Encryption of provider / API-config keys at rest (AES-256-GCM). If unset, a
# key is generated to data/.secret-key on first start. To supply your own:
#   openssl rand -base64 32
# Keep it stable - data encrypted with a lost key cannot be recovered.
# SECRET_ENCRYPTION_KEY=

# Daily log cleanup (usage_logs + audit_logs older than N days are deleted).
# LOG_RETENTION_DAYS=0 disables the cleanup job.
LOG_RETENTION_DAYS=7
LOG_CLEANUP_TIME=03:00

LOG_LEVEL=info
